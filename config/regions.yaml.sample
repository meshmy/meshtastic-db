# Copy to config/regions.yaml (gitignored) and edit for your deployment.
#
# allowed_regions is opt-in by design: nothing is ingested for a region not
# listed here, even if traffic for it is visible on a subscribed broker.
# There's no universally-safe default region, so this ships empty.
allowed_regions: []
# allowed_regions: [MY_919, MY_433]

mqtt:
  # version: 'e' (>=2.3.0) or 'c' (legacy) — subscribe both.
  topic_template: "msh/{region}/2/{version}/#"
  brokers:
    - host: ${MQTT_HOST}
      port: 8883
      tls: true
  channels:
    # "*" is a wildcard fallback tried for any channel_id with no entry of
    # its own — the default PSK ("AQ==") is a single fixed key independent
    # of channel name, so this one entry decrypts LongFast, ShortFast,
    # MediumSlow, and every other default-modem-preset-named or
    # custom-named channel left on the default key. Add a channel by its
    # actual name only when it uses a genuinely custom (non-default) PSK.
    - name: "*"
      psk_base64: "AQ=="

tcp_nodes: []
# tcp_nodes:
#   - host: 192.168.1.50
#     region: MY_919

gateway_agent:
  region: null   # one static region per physical agent instance
  connection: {type: serial, port: /dev/ttyUSB0}   # or {type: ble, ble_address: AA:BB:...}
