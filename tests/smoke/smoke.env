# --env-file for bin/smoke-test.sh's isolated `meshtastic-db-smoke` compose
# project. Every value here is local-only, disposable-container config, not
# a real credential -- this file is committed and reused verbatim on every
# run. Never merged with a deployer's own .env.
POSTGRES_PASSWORD=smoketest
INGEST_DB_PASSWORD=smoketest
GRAFANA_DB_PASSWORD=smoketest
ARCHIVE_DB_PASSWORD=smoketest

RAW_RETENTION_INTERVAL=1 year
RAW_COMPRESS_AFTER=10 days
HOURLY_COMPRESS_AFTER=30 days
DAILY_COMPRESS_AFTER=90 days

# mqtt-ingest's MQTT_HOST/MQTT_USERNAME are overridden in
# docker-compose.test.yml to point at the disposable `mosquitto` service
# instead; the values here are only what docker-compose.yml's other
# variable references need to resolve without a "not set" warning.
MQTT_HOST=mosquitto
MQTT_USERNAME=

ARCHIVE_BACKEND=local
ARCHIVE_SCHEDULE_CRON=0 2 * * *
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GF_SECURITY_ADMIN_PASSWORD=smoketest
