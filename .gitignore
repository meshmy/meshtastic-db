# Local deployment config — copy from the committed *.sample instead
.env
config/regions.yaml
secrets/*
!secrets/*.sample

# Archive tier is a bind-mounted local Parquet root, not repo content
archive/*
!archive/.gitkeep

__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# mosquitto_broker test fixture's bind-mounted conf dir (needs to live
# under the repo tree for colima/Docker on macOS to see it — see conftest.py)
.mqtt-ingest-test-*/

.DS_Store
