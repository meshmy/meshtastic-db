# Copy to .env (gitignored) and fill in real values for your deployment.
# Credentials that should stay out of `docker inspect`/process-env visibility
# live in secrets/*.txt instead — see secrets/*.sample.

POSTGRES_PASSWORD=changeme
INGEST_DB_PASSWORD=changeme
GRAFANA_DB_PASSWORD=changeme

# Retention / rollup — applied only at first DB init (db/init runs once
# against an empty volume); see AGENTS.md for the retune-retention caveat.
RAW_RETENTION_INTERVAL=1 year
RAW_COMPRESS_AFTER=10 days
HOURLY_COMPRESS_AFTER=30 days
DAILY_COMPRESS_AFTER=90 days

MQTT_HOST=mqtt.meshtastic.org
MQTT_USERNAME=meshdev
CHANNEL_PSK_MYSECRET=

INGEST_API_TOKEN=changeme

ARCHIVE_BACKEND=local            # local | s3
ARCHIVE_LOCAL_PATH=/archive
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARCHIVE_SCHEDULE_CRON=0 2 * * *

GF_SECURITY_ADMIN_PASSWORD=changeme
